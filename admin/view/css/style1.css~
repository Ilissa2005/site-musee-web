* { margin: 0; 
padding: 0; 
box-sizing: border-box; 
font-family: Arial, sans-serif; }
body { background: #C3DBCF; color: #333; } /*beige claire*/
nav.navbar
 {
    background-color: #3E633E !important;   /* fond bleu claire */
    padding: 10px;
}

nav.navbar .container-fluid {
    display: flex;
    gap: 20px;
    align-items: center;
}

nav.navbar .navbar-brand {
    color: #637AC2;
    text-decoration: none;
    font-weight: bold;
}

nav.navbar .navbar-brand:hover {
    color:  #C8C3F7; /*ccolor quand la souris est sur le titre de menu */
}

/* Contenu */
main {
    width: 90%;
    margin: 30px auto;
	}

/* Boutons */
.btn {
    padding: 10px 15px;
    border-radius: 5px;
    color: white;
    }

.btn-success { background: #28a745; }
.btn-warning { background: #ffc107; color: black; }
.btn-danger  { background: #dc3545; }
.btn-primary { background: #007bff; }

/* Cartes */
.cards-container { 
display: flex; 
flex-wrap: wrap; 
gap: 20px; 
margin-top: 20px; }
.card {
	background: white;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 15px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* Formulaires */
form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

form input, form textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

form button {
    padding: 10px;
    border: none;
    background: #007bff;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}

form button:hover {
    background: #0056b3;
}
